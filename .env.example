# LLM Provider Configuration
# Choose one: OpenAI, OpenRouter, Gemini, Groq, Ollama, LM Studio, vLLM, DeepSeek, etc.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Examples for other providers:
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=openrouter/free
# Gemini:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=llama-3.3-70b-versatile
# DeepSeek:      LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# Ollama (local): LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3.2  (no API key needed)
# LM Studio:     LLM_BASE_URL=http://localhost:1234/v1          LLM_MODEL=local-model  (no API key needed)
# vLLM:          LLM_BASE_URL=http://localhost:8000/v1          LLM_MODEL=your-model  (no API key needed)


# Optional: Override output directories
# PUBLIC_DIR=public
# OUT_DIR=out