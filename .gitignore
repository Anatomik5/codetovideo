# Dependencies and build output
node_modules/
dist/
build/

# Generated by CTV (sessions, renders, temp captures)
out/
public/*
!public/.gitkeep
*.mp4
!docs/demo.mp4

# Hidden files and folders in the repo root are local-only (editor settings, personal tooling, secrets) ...
/.*
# ... except the project files below
!/.github/
!/.gitignore
!/.gitattributes
!/.env.example

# Only these Markdown documents are published from the repo root
/*.md
!/README.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/CHANGELOG.md
!/ROADMAP.md
!/THIRD_PARTY.md

# Editors, OS, logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.env
.env.*
!.env.example
